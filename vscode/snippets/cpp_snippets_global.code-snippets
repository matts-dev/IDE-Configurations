	"bind_get_method_godot": {"scope": "c,cpp", "prefix": "bind_get_method_godot", "body": [
			"ClassDB::bind_method(D_METHOD(SYMBOL_AS_STR(${FunctionName})), &${TM_FILENAME_BASE}::${FunctionName});"
		],"description": "boilerplate for override _input in gdextension c++."
	},
	"bind_set_method_godot": {"scope": "c,cpp", "prefix": "bind_set_method_godot", "body": [
