	"add_resource_property": {"scope": "c,cpp", "prefix": "add_resource_property", "body": [
			"ADD_PROPERTY( PropertyInfo(Variant::OBJECT, SYMBOL_AS_STR(${prop_name})",
			"\t, PROPERTY_HINT_RESOURCE_TYPE, SYMBOL_AS_STR(${prop_type}))",
			"\t, SYMBOL_AS_STR(set_${prop_name})",
			"\t, SYMBOL_AS_STR(get_${prop_name}));",
		],"description": "boilerplate for adding a property in godot C++."
	},
	
	"generate_godot_property_ref": {"scope": "c,cpp", "prefix": "generate_godot_property_ref", "body": [
			"//copy to hpp-file",
			"Ref<${prop_type}> ${prop_name};",
			"void set_${prop_name}(const Ref<${prop_type}>& in_${prop_name}) { ${prop_name} = in_${prop_name}; }",
			"Ref<${prop_type}> get_${prop_name}() const { return ${prop_name}; }",
			"",
			"//copy to cpp-file",
			"ClassDB::bind_method(D_METHOD(SYMBOL_AS_STR(set_${prop_name}), \"${in_param}\"), &${TM_FILENAME_BASE}::set_${prop_name});",
			"ClassDB::bind_method(D_METHOD(SYMBOL_AS_STR(get_${prop_name})), &${TM_FILENAME_BASE}::get_${prop_name});",
			"ADD_PROPERTY( PropertyInfo(Variant::OBJECT, SYMBOL_AS_STR(${prop_name})",
			"\t, PROPERTY_HINT_RESOURCE_TYPE, SYMBOL_AS_STR(${prop_type}))",
			"\t, SYMBOL_AS_STR(set_${prop_name})",
			"\t, SYMBOL_AS_STR(get_${prop_name}));",
		],"description": "full boilerplate for property of a resource type in godot c++."
	},
	"generate_godot_property_pod": {"scope": "c,cpp", "prefix": "generate_godot_property_pod", "body": [
