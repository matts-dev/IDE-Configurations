			"void set_${prop_name}(const ${prop_type} in_${prop_name}) { ${prop_name} = in_${prop_name}; }",
			"${prop_type} get_${prop_name}() const { return ${prop_name}; }",
			"",
			"//copy to cpp-file",
			"ClassDB::bind_method(D_METHOD(SYMBOL_AS_STR(set_${prop_name}), \"${in_param}\"), &${TM_FILENAME_BASE}::set_${prop_name});",
			"ClassDB::bind_method(D_METHOD(SYMBOL_AS_STR(get_${prop_name})), &${TM_FILENAME_BASE}::get_${prop_name});",
			"ADD_PROPERTY( PropertyInfo(Variant::${FLOAT}, SYMBOL_AS_STR(${prop_name})",
			"\t, PROPERTY_HINT_RESOURCE_TYPE, SYMBOL_AS_STR(${prop_type}))",
			"\t, SYMBOL_AS_STR(set_${prop_name})",
			"\t, SYMBOL_AS_STR(get_${prop_name}));",
		],"description": "full boilerplate for plain old data type."
