	"Generate class header": {
		"scope": "c,cpp",
		"prefix": "classheader-filename",
		"body": [
			"#pragma once",
			"",
			"class ${TM_FILENAME_BASE}",
			"{",
			"public:",
			"\t ${TM_FILENAME_BASE}();",
			"\t virtual ~${TM_FILENAME_BASE}();",
			"private:  ",
			"};",
			"",
		],
		"description": "generates a class header"
	},
	"Generate class body": {
		"scope": "c,cpp",
		"prefix": "classbody-filename",
		"body": [
			"#include \"${TM_FILENAME_BASE}.h\"",
			"",
			"${TM_FILENAME_BASE}::${TM_FILENAME_BASE}()",
			"{ ",
			"\t",
			"} ",
			"${TM_FILENAME_BASE}::~${TM_FILENAME_BASE}()",
			"{ ",
			"\t",
			"}",
			"",
		],
		"description": "generates a class header"
	},

	"godot-class-header-filename": {
		"scope": "c,cpp",
		"prefix": "godot-class-header-filename",
		"body": [
			"#pragma once",
			"",
			"#include \"godot_cpp/classes/node3d.hpp\"",
			"",
			"namespace godot",
			"{",
			"",
			"class ${TM_FILENAME_BASE} : public ${Node3D}",
			"{",
			"\tGDCLASS(${TM_FILENAME_BASE}, ${Node3D})",
			"",
			"public:",
			"\t${TM_FILENAME_BASE}();",
			"\tvirtual ~${TM_FILENAME_BASE}();",
			"private:  ",
			"};",
			"",
			"}//namespace godot",
			"",
		],
		"description": "generates a class header"
	},
	"godot-class-body-filename": {
		"scope": "c,cpp",
		"prefix": "godot-class-body-filename",
		"body": [
			"#include \"${TM_FILENAME_BASE}.h\"",
			"",
			"namespace godot",
			"{",
			"",
			"${TM_FILENAME_BASE}::${TM_FILENAME_BASE}()",
			"{ ",
			"\t${1}",
			"} ",
			"",
			"${TM_FILENAME_BASE}::~${TM_FILENAME_BASE}()",
			"{ ",
			"\t",
			"}",
			"",
			"",
			"}//namespace godot",
			"",
		],
		"description": "generates a class header"
	},
